# Which games this repository ships.  The ones listed here still live in this
# working tree and are still worked on; they are simply not part of this repo.
# The list is not just bookkeeping: the root build.py builds and packages every
# game that is NOT ignored here, so adding or removing a line changes what a
# release contains.  Do not add one back without meaning to ship it.
/.ghidra_smoke/
/.vscode/
/Adieu/
/docs/
/FAVORITE/
/FRATERNITE_HD/
/kishin_hisho/
/sakuranotoki/
/SakuraNoUta/
/TOOLS/

# The aggregate install tree the root build.py stages -- build output, and the
# release artifact is built from it rather than committed.
/install/

# Reverse-engineering scratch: Ghidra scripts and projects, disassembly dumps,
# probe drivers, findings notes.  Every game keeps its own; they are how a hook
# address was found, not part of what ships, and they hard-code this machine's
# Ghidra and game paths.  kishin_hisho spells it `analysis`.
**/analysys/
**/analysis/

# Python
venv/
__pycache__/

# AES passphrase for encrypt_translations.bat — never leaves this PC
key.txt

# Claude Code local config.  CLAUDE.md is instructions for the agent working
# on this machine -- it names the accounts logged in here and how the tree is
# laid out locally, which is nobody else's business and not documentation.
CLAUDE.md
.claude/settings.local.json
.claude/settings.json
.claude/scheduled_tasks.lock

# Build output
# One build tree per game (see SakuraNoUta/BUILD_STRUCTURE.md); the
# per-subfolder trees below are the older layout, still in use elsewhere.
SakuraNoUta/build/
shingakkou/build/
Adieu/build/
CROSS_CHANNEL/build/
amakano2pe/build/
FRATERNITE_HD/build/
FAVORITE/build/
kishin_hisho/build/
sakuranotoki/build/
EXTRAVAGANZA_CE/build/
EXTRAVAGANZA_MATSURO_CE/build/
mushigurui_HD10/build/
**/pipeline_cpp/build/
**/proxy_dll/build/
**/helper_dll/build/
# Conan rewrites this on every `conan install`
**/CMakeUserPresets.json
shingakkou/proxy_dll/_build_log.txt

# Large binaries: process dumps, and what was carved out of them
**/*_dumped.exe
sakuranotoki/analysys/dumps/*.bin
amakano2pe/map_images/

# Regenerated by the pipeline, not authored
**/narrative_extracted/
**/narrative_patched/
**/_debug_title_originals/
**/script_output/extracted_text.json
# Restored on demand by mushigurui_HD10/analysys/retired_py.py
mushigurui_HD10/analysys/_retired/
