# Which games this repository ships.  The ones listed here still live in this
# working tree and are still worked on; they are simply not part of this repo.
# The list is not just bookkeeping: the root build.py builds and packages every
# game that is NOT ignored here, so adding or removing a line changes what a
# release contains.  Do not add one back without meaning to ship it.
/.ghidra_smoke/
/.vscode/
/Adieu/
/docs/
/TOOLS/

# The aggregate install tree the root build.py stages -- build output, and the
# release artifact is built from it rather than committed.
/install/

# Reverse-engineering scratch: Ghidra scripts and projects, disassembly dumps,
# probe drivers, findings notes.  Every game keeps its own; they are how a hook
# address was found, not part of what ships, and they hard-code this machine's
# Ghidra and game paths.  kishin_hisho spells it `analysis`.
**/analysys/
**/analysis/
!kishin_hisho/pipeline_cpp/src/analysis/
!kishin_hisho/pipeline_cpp/src/analysis/**

# ...except FRATERNITE_HD's YBN samples, which are test fixtures rather than
# scratch: ut_ypf_archive and ut_extract build a synthetic bn.ypf out of them
# and cannot run without them.  Ignoring the whole folder lost them once, and
# nothing in git could bring them back.  The rules re-include the folder, then
# exclude everything in it again, so only the .ybn files are tracked and the
# probes and dumps beside them stay out.
# analysys/rebuild_ybn_samples.py regenerates them from a game install.
!FRATERNITE_HD/analysys/
FRATERNITE_HD/analysys/*
!FRATERNITE_HD/analysys/ybn_samples/
FRATERNITE_HD/analysys/ybn_samples/*
!FRATERNITE_HD/analysys/ybn_samples/*.ybn

# Python
venv/
__pycache__/

# The AES passphrase is the root translations_key.txt, which is committed and
# public on purpose.  The rule below is kept so that a stray key.txt — from an
# older checkout, or from another tool — is never committed by accident.
key.txt

# Claude Code local config.  CLAUDE.md is instructions for the agent working
# on this machine -- it names the accounts logged in here and how the tree is
# laid out locally, which is nobody else's business and not documentation.
CLAUDE.md
.claude/settings.local.json
.claude/settings.json
.claude/scheduled_tasks.lock

# Build output
# One build tree per game (see SakuraNoUta/BUILD_STRUCTURE.md); the
# per-subfolder trees below are the older layout, still in use elsewhere.
SakuraNoUta/build/
shingakkou/build/
Adieu/build/
CROSS_CHANNEL/build/
amakano2pe/build/
FRATERNITE_HD/build/
SakuraMoyu/build/
kishin_hisho/build/
sakuranotoki/build/
EXTRAVAGANZA_01_CE/build/
EXTRAVAGANZA_02_MUSHIGURUI_HD10/build/
EXTRAVAGANZA_03_MATSURO_CE/build/
EXTRAVAGANZA_04_AGEHA_CE/build/
EXTRAVAGANZA_05_ANZU_CE/build/
EXTRAVAGANZA_06_YUMEMI_CE/build/
EXTRAVAGANZA_07_REN_MUSHI_CE/build/
EXTRAVAGANZA_08_MIZUNA_CE/build/
Oretachi_ni_Tsubasa_wa_Nai/build/
spot_checker/build/
**/build/
**/pipeline_cpp/build/
**/proxy_dll/build/
**/helper_dll/build/
# Conan rewrites this on every `conan install`
**/CMakeUserPresets.json
**/proxy_dll/_build_log.txt
**/proxy_dll/build.log

# Large binaries: process dumps, and what was carved out of them
**/*_dumped.exe
sakuranotoki/analysys/dumps/*.bin
amakano2pe/map_images/

# Regenerated by the pipeline, not authored
**/narrative_extracted/
**/narrative_patched/
**/_debug_title_originals/
**/script_output/extracted_text.json
**/script_output/argon_spot_check.json
**/script_output/last_gemini_translate/
**/script_output/last_anthropic_translate/
**/translations.tsv
**/translation_table.tsv
# Restored on demand by EXTRAVAGANZA_02_MUSHIGURUI_HD10/analysys/retired_py.py
EXTRAVAGANZA_02_MUSHIGURUI_HD10/analysys/_retired/

# One-off model comparisons.  A shipped game publishes one translated document
# and its cache; these are the scratch that chose the model, not the result.
# The comparison folders were deleted; these rules keep a re-run from being
# committed by accident.
**/test/model_compare/
**/test/sonnet_medium_rolling/

# Paid translations, API caches, and reconstruction maps are tracked only as
# VNE2-encrypted .json.enc files across all shipped games. Plain .json files
# stay on local disk for the pipeline and CTest suites to use, and are
# automatically synced with .json.enc by build.py and spot_checker.
**/script_output/translated_text.json
**/script_output/translation_cache_anthropic.json
**/script_output/translation_cache_gemini.json
**/script_output/chart_translation_cache.json
**/script_output/nps_reconstruction_map.json
**/script_output/coverage_report.json
**/test/translation_run_*.json
**/test/rolling_context_log.json

# Additional sakuranotoki exclusions (in-progress game).
sakuranotoki/translations.tsv
sakuranotoki/script_output/*.log
sakuranotoki/proxy_dll/iarsys_orig.dll

# SakuraNoUta's translate step writes every raw API answer here on each run.
# It repeats the script line by line, and nothing reads it back.
SakuraNoUta/script_output/anthropic_raw_answers.log
_specs*
resume.md
fraternite_hd_box_art_*.png
*.mp4
