{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conan-windows-x64-release",
            "displayName": "Conan Windows x64 Release (Ninja Multi-Config)",
            "description": "64-bit Release build. Binary dir and Conan toolchain both live in the game's single build tree: mushigurui_HD10/build/pipeline. Ninja takes its target architecture from the compiler environment, not from CMake, so the 64-bit target comes from the Conan profile's conanvcvars.bat -- which is why there is no 'architecture' field here.",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "${sourceDir}/../build/pipeline/generators/conan_toolchain.cmake",
            "binaryDir": "${sourceDir}/../build/pipeline",
            "installDir": "${sourceDir}/../build/install",
            "cacheVariables": {
                "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
                "ENABLE_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "conan-windows-x64-release",
            "configurePreset": "conan-windows-x64-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "conan-windows-x64-release",
            "configurePreset": "conan-windows-x64-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
