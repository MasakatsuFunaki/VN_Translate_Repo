{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 15,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conan-windows-x86-release",
            "displayName": "Conan Windows x86 Release (Ninja Multi-Config)",
            "description": "32-bit (Win32) Release build in WelcomeToAnzU_CE/build/proxy.",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "${sourceDir}/../build/proxy/generators/conan_toolchain.cmake",
            "binaryDir": "${sourceDir}/../build/proxy",
            "installDir": "${sourceDir}/../build/install",
            "cacheVariables": {
                "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
                "ENABLE_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "conan-windows-x86-release",
            "configurePreset": "conan-windows-x86-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "conan-windows-x86-release",
            "configurePreset": "conan-windows-x86-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
