{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "WelcomeToAnzU_CE (pipeline x64 + proxy Win32)",
            "description": "Drives both subprojects into WelcomeToAnzU_CE/build/.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/root",
            "installDir": "${sourceDir}/build/install"
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
